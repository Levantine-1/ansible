# Template my.cnf for PXC
# Edit to your requirements.
[client]
socket=/var/run/mysqld/mysqld.sock

[mysqld]
server-id=1
datadir=/var/lib/mysql
socket=/var/run/mysqld/mysqld.sock
log-error=/var/log/mysql/error.log
pid-file=/var/run/mysqld/mysqld.pid

# Binary log expiration period is 604800 seconds, which equals 7 days
binlog_expire_logs_seconds=604800

######## wsrep ###############
# Path to Galera library
wsrep_provider=/usr/lib/galera4/libgalera_smm.so

# Cluster connection URL contains IPs of nodes
#If no IP is found, this implies that a new cluster needs to be created,
#in order to do that you need to bootstrap this node
wsrep_cluster_address=gcomm://{{ groups['PerconaCluster'] | join(',') }}

# In order for Galera to work correctly binlog format should be ROW
binlog_format=ROW

# Slave thread to use
wsrep_slave_threads=8

wsrep_log_conflicts

# This changes how InnoDB autoincrement locks are managed and is a requirement for Galera
innodb_autoinc_lock_mode=2

# Node IP address
wsrep_node_address={{ inventory_hostname }}
# Cluster name
wsrep_cluster_name={{ percona_configs.wsrep_cluster_name }}

#If wsrep_node_name is not specified,  then system hostname will be used
wsrep_node_name={{ inventory_hostname.split('.')[0] }}

#pxc_strict_mode allowed values: DISABLED,PERMISSIVE,ENFORCING,MASTER
pxc_strict_mode=ENFORCING

# SST method
wsrep_sst_method=xtrabackup-v2

# Explicit cert paths for both MySQL's own client-server SSL and Galera's
# inter-node replication channel -- store_certificates.yml/
# deploy_certificates.yml deploy a shared cert set (generated once on the
# bootstrap node, copied to the others) to these exact paths, but nothing
# previously told mysqld/Galera to actually use them. Percona's
# pxc_encrypt_cluster_traffic convention-based auto-discovery (same
# default paths) was found to intermittently pick up each node's own
# independently-generated certs instead of the shared set, causing Galera
# "certificate signature failure" errors between nodes on first cluster
# formation. Being explicit here removes that ambiguity.
ssl-ca=/var/lib/mysql/ca.pem
ssl-cert=/var/lib/mysql/server-cert.pem
ssl-key=/var/lib/mysql/server-key.pem

wsrep_provider_options="socket.ssl_key=/var/lib/mysql/server-key.pem;socket.ssl_cert=/var/lib/mysql/server-cert.pem;socket.ssl_ca=/var/lib/mysql/ca.pem"