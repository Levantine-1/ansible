# Rendered by roles/applications/incident-agent/install.yml. Secrets come from
# Vault at deploy time and are never committed. 0600, root-owned.

# --- Zammad -----------------------------------------------------------------
# Not localhost: unlike zammad_relay.py (which runs on `service` alongside
# Zammad), this agent is on its own VM and reaches it over the internal LAN.
IA_ZAMMAD_URL=http://service.internal.levantine.io:8080
IA_ZAMMAD_API_TOKEN={{ zammad_secrets.api_token }}
IA_ZAMMAD_GROUP=Users
IA_ZAMMAD_CUSTOMER_EMAIL={{ zammad_secrets.admin_email }}
# Genuinely-unfixable (physical/infrastructure) incidents get assigned here
# instead of just tagged. Empty/0 if the human-admin account isn't set up --
# _assign_to_human() no-ops gracefully in that case.
IA_ZAMMAD_HUMAN_ADMIN_USER_ID={{ (human_admin_secrets | default({})).user_id | default(0) }}

# --- Read-only diagnostic sources (all on `service`) -------------------------
# The route prefixes on Prometheus and Alertmanager are load-bearing: both run
# with --web.route-prefix, which covers their API surface too, so the
# unprefixed paths 404.
IA_LOKI_URL=http://service.internal.levantine.io:3100
IA_PROMETHEUS_URL=http://service.internal.levantine.io:9090/prometheus
IA_ALERTMANAGER_URL=http://service.internal.levantine.io:9093/alertmanager

# --- Local model ------------------------------------------------------------
# Swapping models as better small ones ship should be exactly: `ollama pull
# <new>`, change this line, restart the worker. Nothing else references a model
# name, and the prompts target Ollama's standard API rather than any
# model-specific format.
IA_OLLAMA_URL=http://127.0.0.1:11434
IA_OLLAMA_MODEL={{ incident_agent_ollama_model }}
IA_OLLAMA_TIMEOUT=180

# --- Escalation tier --------------------------------------------------------
# Empty until the API key is added to Vault at kv/data/anthropic/incident-agent
# (key: api_key). The agent runs fine without it -- triage, diagnostics,
# allow-listed restarts and ticket notes all work; escalations simply record
# that they could not run and flag the ticket for a human.
IA_ANTHROPIC_API_KEY={{ anthropic_api_key | default('', true) }}
IA_ANTHROPIC_MODEL={{ incident_agent_claude_model }}
IA_ANTHROPIC_MAX_TURNS=24
IA_ANTHROPIC_MAX_INCIDENT_USD=1.50

# --- Budget -----------------------------------------------------------------
# The authoritative cap is the spend limit set on the Anthropic Console
# workspace, which enforces server-side. These are the local, app-level
# backstop so the agent stops deliberately (and says so on the ticket) rather
# than discovering the hard cap as an API error mid-incident.
IA_BUDGET_MONTHLY_USD={{ incident_agent_budget_usd }}
IA_BUDGET_SOFT_FRACTION=0.85

# Local cost estimation only. Overridable because published per-token prices
# change, and a stale constant would silently skew the soft ceiling.
IA_PRICE_INPUT_PER_MTOK=3.00
IA_PRICE_OUTPUT_PER_MTOK=15.00
IA_PRICE_CACHE_WRITE_PER_MTOK=3.75
IA_PRICE_CACHE_READ_PER_MTOK=0.30

# --- Access -----------------------------------------------------------------
IA_SSH_KEY=/etc/incident-agent/automation.pem
IA_SSH_USER=automation

# --- Runtime ----------------------------------------------------------------
IA_CONFIG_DIR=/etc/incident-agent
IA_STATE_DIR=/var/lib/incident-agent
IA_LISTEN_HOST=0.0.0.0
IA_LISTEN_PORT=9098
# CPU inference on 4 cores: more than two concurrent investigations thrash the
# single Ollama instance and make every one of them slower.
IA_MAX_CONCURRENT_TRIAGE=2
IA_WORKER_POLL_SECONDS=15
