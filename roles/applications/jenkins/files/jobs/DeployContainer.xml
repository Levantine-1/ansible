<?xml version='1.1' encoding='UTF-8'?>
<project>
  <actions/>
  <description></description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.ChoiceParameterDefinition>
          <name>services</name>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string></string>
              <string>portfolio</string>
              <string>thisper</string>
              <string>real-estate</string>
              <string>booking-movie-ticket</string>
              <string>education-platform</string>
              <string>dental-care</string>
              <string>pet-care</string>
              <string>processmining</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
  </properties>
  <scm class="hudson.plugins.git.GitSCM" plugin="git@5.2.1">
    <configVersion>2</configVersion>
    <userRemoteConfigs>
      <hudson.plugins.git.UserRemoteConfig>
        <url>https://github.com/Levantine-1/ansible.git</url>
      </hudson.plugins.git.UserRemoteConfig>
    </userRemoteConfigs>
    <branches>
      <hudson.plugins.git.BranchSpec>
        <name>*/master</name>
      </hudson.plugins.git.BranchSpec>
    </branches>
    <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
    <submoduleCfg class="empty-list"/>
    <extensions/>
  </scm>
  <canRoam>true</canRoam>
  <disabled>false</disabled>
  <blockBuildWhenDownstreamBuilding>false</blockBuildWhenDownstreamBuilding>
  <blockBuildWhenUpstreamBuilding>false</blockBuildWhenUpstreamBuilding>
  <authToken>github</authToken>
  <triggers/>
  <concurrentBuild>false</concurrentBuild>
  <builders>
    <hudson.tasks.Shell>
      <command>export ANSIBLE_HOST_KEY_CHECKING=False
download_docker_image=&quot;roles/applications/nginx-proxyContainers/downloadDockerImage.yml&quot;
deploy_docker_image=&quot;roles/applications/nginx-proxyContainers/deployDockerImage.yml&quot;
inventory=&quot;inventories/production/production.ini&quot;
private_key=&quot;~/.ssh/automation.pem&quot;
vault_pass_file=&quot;~/vault_pass&quot;


echo &quot;Downloading Docker image&quot;
ansible-playbook ${download_docker_image} -i ${inventory}  -l localhost -e &quot;container_name=${services}&quot; --vault-password-file &quot;${vault_pass_file}&quot;

echo &quot;Deploying Docker Image&quot;
ansible-playbook ${deploy_docker_image} -i ${inventory}  -l VMWareDockerHosts -e &quot;container_name=${services}&quot; -u automation --private-key &quot;${private_key}&quot; --vault-password-file &quot;${vault_pass_file}&quot;

</command>
      <configuredLocalRules/>
    </hudson.tasks.Shell>
  </builders>
  <publishers/>
  <buildWrappers/>
</project>