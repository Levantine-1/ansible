ZAMMAD_URL=http://localhost:8080
ZAMMAD_API_TOKEN={{ zammad_secrets.api_token }}
ZAMMAD_GROUP=Users
ZAMMAD_CUSTOMER_EMAIL={{ zammad_secrets.admin_email }}
LISTEN_PORT=9099
# Same Vault secret and same id the incident agent uses for
# _assign_to_human() (roles/applications/incident-agent). When a ticket's
# owner is this id, a human has explicitly taken it for a config-change
# review -- the resolve-handler skips auto-closing it out from under them
# and posts a note instead. 0/unset means "no human-admin account
# configured yet", in which case every resolved alert closes as before.
ZAMMAD_HUMAN_ADMIN_USER_ID={{ (human_admin_secrets | default({})).user_id | default(0) }}
# Hands newly created tickets to the incident agent for automated triage
# (roles/applications/incident-agent). Best-effort: if that host is down or
# being rebuilt, ticket creation is unaffected and the ticket just waits for a
# human. Blank this out to disable automated triage without touching the agent.
INCIDENT_AGENT_URL=http://incident-agent.internal.levantine.io:9098
