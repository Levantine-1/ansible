global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["localhost:9093"]

rule_files:
  - /etc/prometheus/alert_rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["localhost:9093"]

  - job_name: node_exporter
    static_configs:
      - targets:
{% for h in monitored_hosts %}
          - "{{ h.host }}:9100"
{% endfor %}
        labels:
          job: node_exporter

  - job_name: cadvisor
    static_configs:
      - targets:
{% for h in monitored_hosts %}
          - "{{ h.host }}:8081"
{% endfor %}
        labels:
          job: cadvisor

  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://levantine.io
          - http://theia.internal.levantine.io
          - http://service.internal.levantine.io:3000
          - http://service.internal.levantine.io:8080
          - http://vault.internal.levantine.io:8200/v1/sys/health
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9115
