global:
  scrape_interval: 15s
  evaluation_interval: 15s

alerting:
  alertmanagers:
    # Alertmanager runs with --web.route-prefix=/alertmanager/, which
    # (like Prometheus's own --web.route-prefix) covers its entire HTTP
    # surface, API included -- without path_prefix here Prometheus was
    # posting alerts to the unprefixed /api/v2/alerts, which 404s. Alert
    # delivery was silently broken until this was added.
    - path_prefix: /alertmanager
      static_configs:
        - targets: ["localhost:9093"]

rule_files:
  - /etc/prometheus/alert_rules.yml

scrape_configs:
  - job_name: prometheus
    # Prometheus itself also runs with --web.route-prefix=/prometheus/,
    # so its own /metrics lives under that prefix too.
    metrics_path: /prometheus/metrics
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    metrics_path: /alertmanager/metrics
    static_configs:
      - targets: ["localhost:9093"]

  - job_name: node_exporter
    static_configs:
      - targets:
{% for h in monitored_hosts %}
          - "{{ h.host }}:9100"
{% endfor %}
        labels:
          job: node_exporter

  - job_name: cadvisor
    static_configs:
      - targets:
{% for h in monitored_hosts %}
          - "{{ h.host }}:8081"
{% endfor %}
        labels:
          job: cadvisor

  - job_name: blackbox_http
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - https://levantine.io
          - http://theia.internal.levantine.io
          - http://service.internal.levantine.io:3000
          - http://service.internal.levantine.io:8080
          - http://vault.internal.levantine.io:8200/v1/sys/health
          # App VIRTUAL_HOSTs on the VMWareDockerHosts nginx-proxy fleet
          # (see inventories/production/group_vars/VMWareDockerHosts) --
          # these had no uptime coverage at all until now.
          - https://thisper.levantine.io
          - https://processmining.levantine.io
          - https://pet-care.levantine.io
          - https://dental-care.levantine.io
          - https://education-platform.levantine.io
          - https://real-estate.levantine.io
          - https://booking-movie-ticket.levantine.io
          # livecam probes /login, not /: everything else there is behind a
          # session now, so / answers 302 and http_2xx would read a healthy
          # app as down. /login is the deepest unauthenticated page that
          # still proves Flask rendered rather than just that nginx-proxy
          # answered.
          #
          # The LAN hostname deliberately, not the public one. Both names
          # reach the same container, but a probe every 30s over the public
          # route would relay through AWS and be billed as egress -- and
          # would land in livecam's own egress counter, quietly inflating
          # the number the dashboard shows the family. The public relay
          # itself is already covered by the other app probes above, which
          # all traverse it.
          - https://livecam-lan.levantine.io/login
          # Frigate's own API, probed directly on the LAN rather than
          # through livecam: livecam gates it behind a session, so a probe
          # would only ever see the login redirect and would stay green
          # even if Frigate itself were down.
          - http://frigate.internal.levantine.io:5000/api/version
          # DataGateway: no VIRTUAL_HOST (k8s NodePort, not behind
          # nginx-proxy), so probe the internal endpoint directly instead.
          - http://kube-c-00.internal.levantine.io:30080/mousey
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: localhost:9115
