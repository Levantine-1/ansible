server {
    listen 80 default_server;
    server_name _;

    root /var/www/ops-dashboard;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # Grafana, Prometheus, and Alertmanager all natively support being
    # served from a subpath (GF_SERVER_SERVE_FROM_SUB_PATH / --web.route-
    # prefix, set in roles/applications/monitoring), so these are true
    # path-based proxies -- the full request path (including the prefix)
    # is forwarded through unstripped, matching what each app expects.
    location /grafana/ {
        proxy_pass http://127.0.0.1:3001/grafana/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /prometheus/ {
        proxy_pass http://127.0.0.1:9090/prometheus/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /alertmanager/ {
        proxy_pass http://127.0.0.1:9093/alertmanager/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OPNsense's web UI has no subpath-serving support -- its HTML
    # references assets/API calls via absolute-root paths (/ui/...,
    # /api/...) regardless of where it's proxied from. This proxy exists
    # purely to make it *reachable* from the home LAN at all -- service
    # is dual-homed onto OPNsense's internal 192.168.1.0/24 LAN and the
    # home LAN can't reach that network directly otherwise. /ui/ and
    # /api/ are proxied at root (unprefixed) alongside /opnsense/ itself
    # so those absolute references still resolve correctly instead of
    # 404ing against this server block.
    location /opnsense/ {
        proxy_pass https://192.168.1.1/;
        proxy_ssl_verify off;
        proxy_set_header Host 192.168.1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # OPNsense sets its PHPSESSID cookie with the Secure flag (it's
        # normally HTTPS-only). This frontend is plain HTTP, so browsers
        # correctly refuse to ever send a Secure cookie back over it --
        # every POST looked like a brand-new session with no valid CSRF
        # token, hence "CSRF check failed" on every login attempt.
        # Confirmed live: the POST request carried no Cookie header at
        # all. Stripping Secure here (safe on our home/VPN-only network)
        # lets the session actually round-trip.
        # The wildcard form (`* nosecure`) silently didn't rewrite
        # anything -- confirmed live against OPNsense's duplicate
        # same-name Set-Cookie headers. Exact cookie names work.
        proxy_cookie_flags PHPSESSID nosecure;
        proxy_cookie_flags cookie_test nosecure;
    }

    location /ui/ {
        proxy_pass https://192.168.1.1/ui/;
        proxy_ssl_verify off;
        proxy_set_header Host 192.168.1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The wildcard form (`* nosecure`) silently didn't rewrite
        # anything -- confirmed live against OPNsense's duplicate
        # same-name Set-Cookie headers. Exact cookie names work.
        proxy_cookie_flags PHPSESSID nosecure;
        proxy_cookie_flags cookie_test nosecure;
    }

    location /api/ {
        proxy_pass https://192.168.1.1/api/;
        proxy_ssl_verify off;
        proxy_set_header Host 192.168.1.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The wildcard form (`* nosecure`) silently didn't rewrite
        # anything -- confirmed live against OPNsense's duplicate
        # same-name Set-Cookie headers. Exact cookie names work.
        proxy_cookie_flags PHPSESSID nosecure;
        proxy_cookie_flags cookie_test nosecure;
    }

    # Vault's UI also has no subpath config and *also* serves its assets
    # from an absolute-root /ui/ path -- same problem as OPNsense, but
    # OPNsense already owns the real /ui/ location on this server block.
    # Rewritten to /vault-ui/ via sub_filter (HTML only; Vault's compiled
    # JS calls the API at /v1/... directly, which doesn't collide with
    # anything else here so it's proxied unchanged).
    location /vault/ {
        proxy_pass http://vault.internal.levantine.io:8200/ui/;
        proxy_set_header Host vault.internal.levantine.io;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        sub_filter '/ui/' '/vault-ui/';
        sub_filter_once off;
        sub_filter_types text/html application/javascript;
    }

    location /vault-ui/ {
        proxy_pass http://vault.internal.levantine.io:8200/ui/;
        proxy_set_header Host vault.internal.levantine.io;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        sub_filter '/ui/' '/vault-ui/';
        sub_filter_once off;
        sub_filter_types text/html application/javascript;
    }

    location /v1/ {
        proxy_pass http://vault.internal.levantine.io:8200/v1/;
        proxy_set_header Host vault.internal.levantine.io;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
