# All the actual proxy rules (Grafana/Prometheus/Alertmanager/chat/OPNsense/
# Vault) live in the shared, non-templated ops-dashboard-locations.conf,
# included below by both server blocks that serve this dashboard -- so
# direct-IP/plain-HTTP access and the HTTPS service.levantine.io vhost stay
# identical without duplicating that hard-won config twice.

server {
    listen 80 default_server;
    server_name _;

    root /var/www/ops-dashboard;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
        # Revalidate every load: the page holds the app links, and a stale
        # cached copy kept sending browsers to old URLs (2026-11-09).
        add_header Cache-Control "no-cache";
    }

    include /etc/nginx/snippets/ops-dashboard-locations.conf;
}

# service.levantine.io -- a Route53 A record pointing at this host's LAN IP
# (terraform/route53/hosted_zones/levantine.io.tf), not intended to be
# reachable outside the house. Scoped to this specific server_name, not
# default_server, so it doesn't change behavior for direct-IP access or any
# other hostname someone might use to reach this box on port 80.
server {
    listen 80;
    server_name service.levantine.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name service.levantine.io;

    # The same wildcard cert every other nginx vhost in the fleet uses
    # (roles/os_configs/deploySSLCerts.yml already targets this host --
    # `hosts: Nginx:service` -- so no new cert issuance needed here).
    ssl_certificate     /etc/nginx/certs/levantine.io/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/levantine.io/privkey.pem;

    root /var/www/ops-dashboard;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
        # Revalidate every load: the page holds the app links, and a stale
        # cached copy kept sending browsers to old URLs (2026-11-09).
        add_header Cache-Control "no-cache";
    }

    include /etc/nginx/snippets/ops-dashboard-locations.conf;
}

# Zammad and Semaphore on their well-known ports, over HTTP *and* HTTPS.
#
# Neither app speaks TLS and neither is happy under a sub-path, so nginx
# owns their public ports (8080, 3000) and the apps listen on loopback
# only (ops_dashboard_tls_direct_apps' upstream_port; the zammad and
# semaphore roles bind there). Each port is a TLS listener, and
# `error_page 497` -- nginx's hook for "plain HTTP arrived on a TLS port"
# -- proxies plain requests to the same upstream instead of rejecting
# them. So https://service.levantine.io:8080 works for browsers, and
# http://service.internal.levantine.io:8080 keeps working unchanged for
# in-fleet callers (incident-agent, zammad-relay, blackbox, Semaphore's
# bootstrap script) without any of them learning about certificates.
#
# Why: browsers reach these by hostname now, and https://...:8080 --
# typed, bookmarked, autocompleted or HTTPS-upgraded -- failed with
# SSL_ERROR_RX_RECORD_TOO_LONG (2026-11-09). A separate TLS port (the
# first fix, 8443/3443) didn't help anyone whose browser already had the
# old port; those ports are kept as aliases so links from then still work.
#
# Ordering: nginx can only bind 8080/3000 once the apps have moved off
# them, so the zammad and semaphore roles must have run first on a host
# where they still hold those ports (on a fresh host order doesn't matter;
# nginx just answers 502 until the app is up).
map $http_upgrade $ops_direct_connection_upgrade {
    default upgrade;
    ''      '';
}

# No-login access for the home LAN (2026-11-10).
#
# Zammad, Semaphore and Grafana sign home-LAN visitors in automatically:
# nginx supplies the credential (Zammad: its SSO header, on /auth/sso
# only; Semaphore: an admin API token; Grafana: its auth-proxy header).
# $ops_autologin decides when, and all three conditions must hold:
#
#   - the client is on the home LAN (ops_dashboard_autologin_networks) --
#     not the fleet network, not the WireGuard bastion;
#   - the Host is one of this host's own names -- otherwise a DNS-rebinding
#     page (attacker's name resolving to 10.69.69.50) would get admin;
#   - there is no Origin header, or it is one of those names -- otherwise
#     any website open in a LAN browser could POST to Semaphore or open
#     its websocket and ride the injected token.
#
# Anyone else gets each app's normal login. Client-supplied copies of the
# injected headers never pass through: proxy_set_header replaces them, and
# an empty value drops them.
geo $ops_lan_client {
    default 0;
{% for net in ops_dashboard_autologin_networks %}
    {{ net }} 1;
{% endfor %}
}

map $host $ops_own_host {
    default 0;
{% for h in ops_dashboard_own_hosts %}
    "{{ h }}" 1;
{% endfor %}
}

map $http_origin $ops_own_origin {
    ""      1;
    "~^https?://({{ ops_dashboard_own_hosts | map('regex_escape') | join('|') }})(:[0-9]+)?$" 1;
    default 0;
}

map "$ops_lan_client$ops_own_host$ops_own_origin" $ops_autologin {
    "111"   1;
    default 0;
}

# Used by /grafana/ in ops-dashboard-locations.conf. Grafana trusts the
# header only from 127.0.0.1 (GF_AUTH_PROXY_WHITELIST), i.e. from here.
map $ops_autologin $ops_grafana_user {
    1       "{{ ops_dashboard_grafana_autologin_user }}";
    default "";
}
{% macro direct_proxy(app, proto) %}
{% if app.autologin | default('') == 'zammad_sso' %}
        # A LAN visit to the bare app URL signs in via SSO first.
        # /auth/sso redirects back to "/#", rewritten to "/?sso=1" so this
        # doesn't loop -- and with no fragment of its own, the browser keeps
        # the one it came with (#ticket/zoom/123 bookmarks survive).
        if ($ops_zammad_sso_redirect) {
            return 302 /auth/sso;
        }
        proxy_pass http://127.0.0.1:$ops_zammad_upstream;
        proxy_set_header X-Forwarded-User $ops_zammad_sso_user;
        proxy_redirect ~^(https?://[^/]+)?/#?$ /?sso=1;
{% else %}
        proxy_pass http://127.0.0.1:{{ app.upstream_port }};
{% endif %}
{% if app.autologin | default('') == 'semaphore_token' %}
        proxy_set_header Authorization $ops_semaphore_authorization;
{% endif %}
        proxy_http_version 1.1;
        # $http_host keeps the port, so the app builds links (and checks
        # Origin) against the address the browser actually used.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto {{ proto }};
        proxy_set_header X-Forwarded-Ssl {{ 'on' if proto == 'https' else 'off' }};
        # Both apps push live updates over WebSockets (Zammad /ws, Semaphore /api/ws).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ops_direct_connection_upgrade;
        proxy_read_timeout 300s;
{% endmacro %}
{% for app in ops_dashboard_tls_direct_apps %}
{% if app.autologin | default('') == 'zammad_sso' %}

# Zammad SSO (setting auth_sso, enabled by roles/applications/zammad).
# Only /auth/sso goes straight to the Rails server: Zammad's own nginx
# blanks X-Forwarded-User, which is right for every other path.
map $uri $ops_zammad_upstream {
    /auth/sso {{ app.sso_upstream_port }};
    default   {{ app.upstream_port }};
}
map $ops_autologin $ops_zammad_sso_user {
    1       "{{ ops_dashboard_zammad_autologin_user }}";
    default "";
}
map "$ops_autologin:$request_method:$uri:$args" $ops_zammad_sso_redirect {
    "1:GET:/:" 1;
    default    0;
}
{% elif app.autologin | default('') == 'semaphore_token' %}

# Semaphore: the token comes from a root-only include (written by
# install.yml); a client's own Authorization header always wins, so API
# callers keep authenticating as themselves.
include {{ ops_dashboard_semaphore_token_file }};
map $http_authorization $ops_semaphore_authorization {
    ""      $ops_semaphore_token;
    default $http_authorization;
}
{% endif %}

# {{ app.name }}: :{{ app.port }} (and alias :{{ app.alias_port }}), HTTP or HTTPS -> 127.0.0.1:{{ app.upstream_port }}
# The only server on these ports, so it also answers bare-IP and
# *.internal hostnames.
server {
    listen {{ app.port }} ssl;
    listen {{ app.alias_port }} ssl;
    server_name service.levantine.io;

    ssl_certificate     /etc/nginx/certs/levantine.io/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/levantine.io/privkey.pem;

    client_max_body_size 50m;
    # Relative Location headers: an absolute one built here could pick the
    # wrong scheme for a plain-HTTP request on this TLS port.
    absolute_redirect off;

    error_page 497 = @plain_http;

    location / {
{{ direct_proxy(app, 'https') }}
    }

    location @plain_http {
{{ direct_proxy(app, 'http') }}
    }
}
{% endfor %}
