# All the actual proxy rules (Grafana/Prometheus/Alertmanager/chat/OPNsense/
# Vault) live in the shared, non-templated ops-dashboard-locations.conf,
# included below by both server blocks that serve this dashboard -- so
# direct-IP/plain-HTTP access and the HTTPS service.levantine.io vhost stay
# identical without duplicating that hard-won config twice.

server {
    listen 80 default_server;
    server_name _;

    root /var/www/ops-dashboard;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    include /etc/nginx/snippets/ops-dashboard-locations.conf;
}

# service.levantine.io -- a Route53 A record pointing at this host's LAN IP
# (terraform/route53/hosted_zones/levantine.io.tf), not intended to be
# reachable outside the house. Scoped to this specific server_name, not
# default_server, so it doesn't change behavior for direct-IP access or any
# other hostname someone might use to reach this box on port 80.
server {
    listen 80;
    server_name service.levantine.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name service.levantine.io;

    # The same wildcard cert every other nginx vhost in the fleet uses
    # (roles/os_configs/deploySSLCerts.yml already targets this host --
    # `hosts: Nginx:service` -- so no new cert issuance needed here).
    ssl_certificate     /etc/nginx/certs/levantine.io/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/levantine.io/privkey.pem;

    root /var/www/ops-dashboard;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    include /etc/nginx/snippets/ops-dashboard-locations.conf;
}

# TLS front doors for the dashboard's "direct" apps (index.html.j2's
# `direct` list). Neither Zammad (zammad-nginx, :8080) nor Semaphore (:3000)
# speaks TLS itself, and neither is happy under a sub-path, so instead of a
# /zammad/ location each gets its own TLS port on the same hostname and
# wildcard cert. The plain-HTTP ports stay as they were, so direct-IP access
# and in-fleet callers (incident-agent posts to
# http://service.internal.levantine.io:8080) are unaffected.
#
# Why this exists: browsers in HTTPS-First/HTTPS-Only mode (Firefox's
# behaviour for hostnames, not bare IPs) upgrade http://service.levantine.io:8080
# to https://...:8080 and fail with SSL_ERROR_RX_RECORD_TOO_LONG -- found
# 2026-11-09, once service.levantine.io was how people reached the
# dashboard instead of a bare IP.
map $http_upgrade $ops_direct_connection_upgrade {
    default upgrade;
    ''      '';
}
{% for app in ops_dashboard_tls_direct_apps %}

# {{ app.name }}: https://service.levantine.io:{{ app.tls_port }} -> 127.0.0.1:{{ app.port }}
server {
    listen {{ app.tls_port }} ssl;
    server_name service.levantine.io;

    ssl_certificate     /etc/nginx/certs/levantine.io/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/levantine.io/privkey.pem;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:{{ app.port }};
        proxy_http_version 1.1;
        # $http_host keeps the :{{ app.tls_port }}, so the app builds links
        # (and checks Origin) against the address the browser actually used.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Ssl on;
        # Both apps push live updates over WebSockets (Zammad /ws, Semaphore /api/ws).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $ops_direct_connection_upgrade;
        proxy_read_timeout 300s;
    }
}
{% endfor %}
