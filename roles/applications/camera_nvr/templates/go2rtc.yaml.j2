{{ ansible_managed | comment }}
# Rendered from roles/applications/camera_nvr/templates/go2rtc.yaml.j2.
# Contains RTSP credentials (from Vault) -- not world-readable, never
# committed. Edit the template, not this file.

api:
  # LAN-only: this VM has a single NIC on vmbr1 and no public path of its
  # own. livecam on dockerhost1 is the only thing that proxies these
  # streams publicly, and it does the auth/permission checks first.
  listen: ":1984"

rtsp:
  listen: ":8554"

webrtc:
  listen: ":8555"

log:
  level: info

streams:
{% for cam in cameras %}
  # --- {{ cam.name }} ---
  # Main stream, 2960x1668 (~7 Mbps). Pulled lazily, only while something
  # is watching, and shared across all viewers of this camera.
  {{ cam.name }}: "rtsp://{{ camera_secrets.username | urlencode }}:{{ camera_secrets.password | urlencode }}@{{ cam.ip }}:554/cam/realmonitor?channel={{ cam.channel | default(1) }}&subtype=0"

  # Audio-stripped variant. Referencing the stream above by name means the
  # camera is still only pulled once even when both variants are in use.
  # #video=copy remuxes video through untouched and drops audio entirely --
  # verified against a live camera: this produces a video-only track list,
  # not merely a muted one, so a user without audio permission genuinely
  # cannot receive audio rather than relying on a client-side mute.
  {{ cam.name }}_noaudio: "ffmpeg:{{ cam.name }}#video=copy"

  # Substream, 704x480 (~0.6 Mbps, ~11x cheaper). Not the default -- it's
  # the graceful-degradation target if too many people watch at once, since
  # full-HD viewers are limited by home upload bandwidth long before
  # anything else.
  {{ cam.name }}_sub: "rtsp://{{ camera_secrets.username | urlencode }}:{{ camera_secrets.password | urlencode }}@{{ cam.ip }}:554/cam/realmonitor?channel={{ cam.channel | default(1) }}&subtype=1"
  {{ cam.name }}_sub_noaudio: "ffmpeg:{{ cam.name }}_sub#video=copy"

{% endfor %}
