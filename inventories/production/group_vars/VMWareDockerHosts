supported_containers:
  nginx-proxy:
    env_vars:
      foo: bar

  portfolio:
    env_vars:
      VIRTUAL_HOST: levantine.io

  thisper:
    env_vars:
      VIRTUAL_HOST: thisper.levantine.io
      DATA_GATEWAY_URL: http://kube-c-00.internal.levantine.io:30080
    # Migrated off the old hardcoded DATA_GATEWAY_API_KEY_PATH handling in
    # deployDockerImage.yml (which its own comment called temporary) onto
    # the generic mechanism. Same secret, same resulting env var.
    vault_secrets:
      - path: kv/data/k8clusters/DataGatewayK8Cluster/thisperAPIKey
        env:
          DATA_GATEWAY_API_KEY: api_key

  livecam:
    env_vars:
      # Two hostnames: the public one relays via the AWS bastion, the -lan
      # one resolves to this host directly so home traffic never leaves the
      # LAN -- no AWS egress, and recorded playback loads at LAN speed.
      # Both are covered by the *.levantine.io wildcard cert.
      VIRTUAL_HOST: livecam.levantine.io,livecam-lan.levantine.io
      PUBLIC_HOSTNAME: livecam.levantine.io
      LAN_HOSTNAME: livecam-lan.levantine.io
      # Two backends on the same host, deliberately split by job. go2rtc
      # serves live view by remuxing the camera stream; Frigate owns
      # recording, retention, the scrub timeline and export. Both are on
      # the frigate VM because Frigate ships go2rtc and drives its restream
      # through it -- one go2rtc means one connection per camera serving
      # both recording and live view, rather than each opening its own.
      #
      # ZoneMinder is gone: it recorded correctly but is event-oriented
      # rather than timeline-oriented, with no continuous scrub bar and no
      # live previews.
      FRIGATE_URL: http://frigate.internal.levantine.io:5000
      GO2RTC_URL: http://frigate.internal.levantine.io:1984
      PERMISSIONS_FILE: /app/config/permissions.yml
      # PTZ-capable cameras and their ONVIF details -- see that file's own
      # header for why it's kept separate from permissions.yml. PTZ talks
      # straight to the camera, deliberately bypassing Frigate the same way
      # live view already does via go2rtc.
      CAMERAS_FILE: /app/config/cameras.yml
    # FLASK_SECRET_KEY: the session secret. Losing it only logs everyone out.
    #
    # CAMERA_USERNAME/CAMERA_PASSWORD: the assumed-shared account for both
    # RTSP streaming and ONVIF PTZ control on this camera family -- same
    # secret Frigate's role already reads for RTSP, reused here rather than
    # duplicated. A per-camera override in cameras.yml exists for the case
    # where a specific camera turns out to need its own ONVIF account.
    #
    # The ZM_DB_* credentials that used to be here are gone with the code
    # that needed them: livecam resolved a forwarded ZMSESSID back to a
    # username by reading ZM's Sessions table and regex-matching PHP
    # session serialization. It has its own accounts now, so it no longer
    # needs any access to a recorder's database.
    #
    # Injected from Vault at deploy time so none of it is baked into the
    # image or committed.
    vault_secrets:
      - path: kv/data/livecam/admin
        env:
          FLASK_SECRET_KEY: flask_secret_key
      - path: kv/data/cameras/amcrest
        env:
          CAMERA_USERNAME: username
          CAMERA_PASSWORD: password
    # Per-user permissions and camera wiring are config, not secrets, so
    # they live in git and are mounted read-only rather than baked into the
    # image -- editing who can see which camera, or adding a PTZ camera,
    # shouldn't need a rebuild and redeploy.
    volumes:
      - /opt/livecam/permissions.yml:/app/config/permissions.yml:ro
      - /opt/livecam/cameras.yml:/app/config/cameras.yml:ro
      # Writable, unlike the permissions mount: holds the SQLite egress
      # counter, which must survive container recreation to be meaningful.
      - /opt/livecam/data:/app/data

