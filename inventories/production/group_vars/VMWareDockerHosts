supported_containers:
  nginx-proxy:
    env_vars:
      foo: bar

  portfolio:
    env_vars:
      VIRTUAL_HOST: levantine.io

  thisper:
    env_vars:
      VIRTUAL_HOST: thisper.levantine.io
      DATA_GATEWAY_URL: http://kube-c-00.internal.levantine.io:30080
    # Migrated off the old hardcoded DATA_GATEWAY_API_KEY_PATH handling in
    # deployDockerImage.yml (which its own comment called temporary) onto
    # the generic mechanism. Same secret, same resulting env var.
    vault_secrets:
      - path: kv/data/k8clusters/DataGatewayK8Cluster/thisperAPIKey
        env:
          DATA_GATEWAY_API_KEY: api_key

  livecam:
    env_vars:
      VIRTUAL_HOST: livecam.levantine.io
      # Two backends, deliberately: ZoneMinder serves recorded playback
      # (it hands over the stored mp4 and the browser decodes it -- no
      # server-side decoding involved), while go2rtc serves live view by
      # remuxing the camera stream. Live view is NOT ZM's job here; ZM's
      # MJPEG live path decodes every frame and is what pinned the VM.
      ZM_BACKEND_URL: http://cameras.internal.levantine.io
      GO2RTC_URL: http://cameras.internal.levantine.io:1984
      PERMISSIONS_FILE: /app/config/permissions.yml
    # Read-only credentials for resolving a ZM session cookie to a
    # username, plus the Flask session secret. Injected from Vault at
    # deploy time so none of it is baked into the image or committed.
    vault_secrets:
      - path: kv/data/livecam/admin
        env:
          FLASK_SECRET_KEY: flask_secret_key
          ZM_DB_HOST: zm_db_host
          ZM_DB_USER: zm_db_user
          ZM_DB_PASSWORD: zm_db_password
    # Per-user permissions are config, not secrets, so they live in git and
    # are mounted read-only rather than baked into the image -- editing who
    # can see which camera shouldn't need a rebuild and redeploy.
    volumes:
      - /opt/livecam/permissions.yml:/app/config/permissions.yml:ro

  processmining:
    env_vars:
      VIRTUAL_HOST: processmining.levantine.io

  pet-care:
    env_vars:
      VIRTUAL_HOST: pet-care.levantine.io

  dental-care:
    env_vars:
      VIRTUAL_HOST: dental-care.levantine.io

  education-platform:
    env_vars:
      VIRTUAL_HOST: education-platform.levantine.io

  real-estate:
    env_vars:
