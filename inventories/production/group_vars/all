env_context: prod

domains:
    - levantine.io

aws:
    default_region: us-west-2
    account_id: 975050308029

hashicorp:
    vault:
        address: http://vault.internal.levantine.io:8200
        # Token in ansible-vault

splunk:
    server:
        host: splunk.internal.levantine.io
        port: 9997
    forwarders:
        insecureskipverify: "true"
        http_event_collector_port: 8088

# OPNsense's DNS resolver has no records for internal.levantine.io (queries
# for e.g. vault.internal.levantine.io NXDOMAIN there) -- despite
# configureHostFile.yml being marked "deprecated by OPNsense", this static
# /etc/hosts block is still the thing that actually makes internal hostname
# resolution work fleet-wide. Kept in sync here so every host in all.yml's
# bootstrap gets it, instead of only whichever hosts had it hand-added.
host_entries: |
    192.168.1.10 vmwarebastion.internal.levantine.io
    192.168.1.20 jenkins.internal.levantine.io
    192.168.1.30 theia.internal.levantine.io
    192.168.1.31 dockerhost1.internal.levantine.io
    192.168.1.41 vault.internal.levantine.io
    192.168.1.50 service.internal.levantine.io